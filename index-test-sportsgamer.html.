
<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Swiss NHL League | Test</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#08111f;color:#fff;font-family:Arial,sans-serif}
header{background:#101e34;padding:22px;border-bottom:3px solid #2586ff}
h1{margin:0;font-size:26px}
h1 span{color:#2586ff}
nav{display:flex;gap:16px;overflow-x:auto;padding:16px;background:#14243b}
a{color:#fff;text-decoration:none;white-space:nowrap}
.hero{padding:45px 20px;background:linear-gradient(135deg,#123c70,#08111f)}
.hero h2{font-size:32px;margin:0 0 12px}
main{max-width:1100px;margin:auto;padding:20px}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:16px}
.card{background:#16263d;padding:22px;border-radius:12px;border:1px solid #294b73}
.card h3{color:#69b4ff}
footer{text-align:center;padding:25px;color:#9bb0c9}
